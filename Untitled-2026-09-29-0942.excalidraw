    {
      "id": "UtVt6wYcX4Sm1mEnc6Zrc",
      "type": "text",
      "x": 580.506398997082,
      "y": 838.5557301861427,
      "width": 783.3594360351562,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 811653483,
      "version": 858,
      "versionNonce": 667423653,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790656606226,
      "created": 1790656020697,
      "link": null,
      "locked": false,
      "text": "User Story - Problem faced by user (Divides into small task or sprints)\nfew problems are --\n1. low customer retention\n2. not getting enough social media reach\nProduct owner or scrum master create BRD(Business Record Draft)\nBRD will not be shared to team directly\nScrum master create FRD(Functional Requirement Draft) to represent to team .\nBoth drafts are created by BA(Business Analyst)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User Story - Problem faced by user (Divides into small task or sprints)\nfew problems are --\n1. low customer retention\n2. not getting enough social media reach\nProduct owner or scrum master create BRD(Business Record Draft)\nBRD will not be shared to team directly\nScrum master create FRD(Functional Requirement Draft) to represent to team .\nBoth drafts are created by BA(Business Analyst)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
